# Application reads exported process environment only; it does not load .env.
# Compose reads .env for interpolation (AIRFLOW_ADMIN_PASSWORD below), but does
# not automatically forward application settings to Airflow services.
APP_ENV=development
# DEBUG, INFO, WARNING, ERROR, CRITICAL or NOTSET (case-insensitive); default INFO.
LOG_LEVEL=INFO
# Unset: repository-relative data/raw/UCI_Credit_Card.csv.
# Relative overrides resolve against the process working directory.
# CREDIT_SCORING_DATASET=data/raw/UCI_Credit_Card.csv
# Optional positive override; unset: CLI/library 1000, training DAG 300.
# CREDIT_SCORING_MAX_ITER=1000
# Positive count; retraining DAG default 500, independent of ordinary iterations.
CREDIT_SCORING_RETRAIN_MAX_ITER=500
# Inclusive range 0..1; data-quality DAG default 0.10.
CREDIT_SCORING_MAX_MISSING_RATIO=0.10
# Unset by default. CLI still requires --enable-mlflow; retraining opts in on URI.
# CREDIT_SCORING_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
CREDIT_SCORING_MLFLOW_EXPERIMENT=credit-scoring

# Airflow local credentials (used by docker/podman compose)
AIRFLOW_ADMIN_PASSWORD=change-me-please

# Registry mode requires a nonempty tracking URI and enables tracking.
CREDIT_SCORING_REGISTRY_ENABLED=false
CREDIT_SCORING_REGISTERED_MODEL_NAME=credit-scoring
# Optional TOML override; unset loads the packaged promotion.toml.
# CREDIT_SCORING_PROMOTION_POLICY_PATH=promotion.toml

# Serving: registry requires the shared tracking URI and registered model name above.
CREDIT_SCORING_SERVING_MODEL_SOURCE=registry
# Local mode requires an existing trusted MLflow sklearn model directory.
# CREDIT_SCORING_SERVING_MODEL_PATH=models/local
CREDIT_SCORING_SERVING_HOST=127.0.0.1
CREDIT_SCORING_SERVING_PORT=8000
# Finite thresholds: 0 < medium < high < 1.
CREDIT_SCORING_RISK_MEDIUM_THRESHOLD=0.20
CREDIT_SCORING_RISK_HIGH_THRESHOLD=0.50
